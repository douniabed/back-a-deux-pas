# =============================================================================
# ENVIRONMENT VARIABLES TEMPLATE
# =============================================================================
# This file documents all environment variables used by the application
#
# SETUP INSTRUCTIONS:
#   1. Copy this file to .env in the same directory
#   2. Replace all placeholder values with your actual credentials
#   3. Never commit .env file to version control (already in .gitignore)
#
# FOR JENKINS CI/CD:
#   Store these as Jenkins credentials (Secret Text or Secret File)
#   and inject them into the build environment
# =============================================================================

# =============================================================================
# DATABASE CREDENTIALS
# =============================================================================
DB_URL=jdbc:mysql://localhost:3306/adeuxpas?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=Europe/Paris&allowPublicKeyRetrieval=true
DB_USERNAME=adeuxpas_admin
DB_PASSWORD=your_secure_database_password_here

# =============================================================================
# JWT SECRET KEY
# =============================================================================
# CRITICAL: Generate a strong random secret for production
# Generate with: openssl rand -base64 64
# This should be at least 64 characters long
JWT_SECRET=qvnedhC913F07EtfEC5EkM120j5k1cLXS3mbYOtsEbF1wAPK28ezFMxtW4Fx+FIUW+qntc2cUHz1LQa2g4Bvg==

# =============================================================================
# CLOUDINARY CREDENTIALS (Image Storage)
# =============================================================================
# Sign up at https://cloudinary.com
CLOUDINARY_URL=https://res.cloudinary.com/your_cloud_name/image/upload/
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# =============================================================================
# STRIPE CREDENTIALS (Payment Processing)
# =============================================================================
# Get from https://dashboard.stripe.com/apikeys
# DEV: Use test keys (sk_test_*)
# PROD: Use live keys (sk_live_*)
STRIPE_API_KEY=sk_test_your_stripe_api_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret

# =============================================================================
# SEED DATA PASSWORDS (DEV/TEST ENVIRONMENTS ONLY)
# =============================================================================
# These are used to seed test users in development
# REMOVE or DISABLE in production environments
SEED_PASSWORD_1=password1
SEED_PASSWORD_2=password2
SEED_PASSWORD_3=password3
SEED_PASSWORD_4=password4
SEED_PASSWORD_5=password5
SEED_PASSWORD_6=password6
SEED_PASSWORD_7=password7
SEED_PASSWORD_8=password8

# =============================================================================
# JENKINS CREDENTIALS MAPPING
# =============================================================================
# When setting up Jenkins, create these credentials:
#
# Secret Text Credentials:
#   - ID: db-password          -> DB_PASSWORD
#   - ID: jwt-secret           -> JWT_SECRET
#   - ID: cloudinary-secret    -> CLOUDINARY_API_SECRET
#   - ID: stripe-api-key       -> STRIPE_API_KEY
#   - ID: stripe-webhook       -> STRIPE_WEBHOOK_SECRET
#
# Secret File Credentials (Alternative):
#   - ID: app-dev-properties   -> Complete application-dev.properties file
#   - ID: app-prod-properties  -> Complete application-prod.properties file
#
# Usage in Jenkinsfile:
#   environment {
#     DB_PASSWORD = credentials('db-password')
#     JWT_SECRET = credentials('jwt-secret')
#     // ... etc
#   }
# =============================================================================
